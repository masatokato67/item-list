  "sections": [
    {
      "id": "housework",
      "heading": "家事の自動化（掃除・洗濯・料理）",
      "intro": "もっとも効果が分かりやすいのが、毎日発生する家事を機械に渡す買い物です。価格は高めですが、1日あたりに直すと負担感は小さくなります。設置スペースと搬入経路を先に確認しておきましょう。"
    },
    {
      "id": "smart",
      "heading": "スマートホーム（鍵・リモコン・カーテン）",
      "intro": "数千円から始められて、生活の小さなストレスを減らせるのがこの分野です。まずはスマートリモコンやプラグなど安いものから試し、よければ鍵やカーテンに広げると失敗しにくくなります。賃貸でも使える工事不要の製品が中心です。"
    },
    {
      "id": "desk",
      "heading": "デスク・在宅ワーク環境",
      "intro": "在宅で働く時間が長い人ほど、机まわりへの投資は体感が大きい分野です。昇降デスクのような大物から、充電器やハブのように数千円で済むものまで幅があります。"
    },
    {
      "id": "av",
      "heading": "エンタメ・リラックス",
      "intro": "家で過ごす時間を良くする買い物です。テレビまわりは数千円のデバイスで使い勝手が変わります。音や映像は好みが分かれるので、レビューで使用環境が近い人の感想を見ておくと安心です。"
    },
    {
      "id": "care",
      "heading": "体のケア・部屋の環境",
      "intro": "毎日使うものほど、少し良いものにすると差が出ます。ドライヤーや電動歯ブラシのように毎日触れるもの、空気清浄機のように置きっぱなしで効くものが中心です。"
    }
  ]
}
